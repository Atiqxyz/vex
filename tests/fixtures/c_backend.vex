make main() {
    say(sum_array([2, 4, 6]))
    let source_values: int[3] = [2, 4, 6]
    let updated_values: int[3] = replace_first(source_values, 9)
    say(sum_array(updated_values))
    say(sum_array(source_values))
    let copied_values: int[3] = identity_array(updated_values)
    say(sum_array(copied_values))
    let decimal_values: float[2] = [1, 3.0]
    say(average_values(decimal_values))
    let labels: string[2] = ["VEX", "arrays"]
    say(first_label(labels))
    let flags: bool[2] = [true, false]
    say(both_flags(flags))
    let copied_decimals: float[2] = identity_floats(decimal_values)
    say(copied_decimals[0])
    let copied_labels: string[2] = identity_labels(labels)
    say(copied_labels[1])
    let copied_flags: bool[2] = identity_flags(flags)
    say(copied_flags[0])

    say(-7 % 3)
    say(7 % -3)
    say(-7 % -3)
    let signed_remainder = -7
    signed_remainder %= 3
    say(signed_remainder)
    let minimum_integer = -9223372036854775807 - 1
    say(minimum_integer % -1)

    say(trace_int(1) - trace_int(2))
    say(combine_values(trace_int(3), trace_int(4)))
    let ordered_values = [trace_int(5), trace_int(6)]
    say(ordered_values[0] + ordered_values[1])
    let writable_values = [0,]
    writable_values[trace_int(0)] = trace_int(7)
    say(writable_values[0])
    let skipped_and = false && trace_bool(8, true)
    let skipped_or = true || trace_bool(9, false)
    let executed_and = true && trace_bool(10, true)
    let executed_or = false || trace_bool(11, true)
    say(executed_and)
    say(executed_or)
    let range_order_sum = 0
    for index in trace_int(12)..trace_int(14) {
        range_order_sum += index
    }
    say(range_order_sum)
    let outer_iterations = 0
    let inner_hits = 0
    repeat 2 times {
        outer_iterations += 1
        for index in 1..=4 {
            if index == 2 { continue }
            if index == 4 { break }
            inner_hits += 1
        }
    }
    say(outer_iterations)
    say(inner_hits)
    let repeat_outer_iterations = 0
    let repeat_inner_hits = 0
    let repeat_step = 0
    repeat 2 times {
        repeat_outer_iterations += 1
        repeat_step = 0
        repeat 4 times {
            repeat_step += 1
            if repeat_step == 2 { continue }
            if repeat_step == 4 { break }
            repeat_inner_hits += 1
        }
    }
    say(repeat_outer_iterations)
    say(repeat_inner_hits)
    let while_outer_iterations = 0
    let while_inner_hits = 0
    let while_step = 0
    while while_outer_iterations < 2 {
        while_step = 0
        while while_step < 4 {
            while_step += 1
            if while_step == 2 { continue }
            if while_step == 4 { break }
            while_inner_hits += 1
        }
        while_outer_iterations += 1
    }
    say(while_outer_iterations)
    say(while_inner_hits)

    say(factorial(5))
    say(is_even(8))
    say(is_odd(7))
    let total = combine(10, 20)
    say(total)

    let message = "VEX\ncompiler"
    say(message)

    let same = "VEX" == "VEX"
    let enabled = same && total == 30
    if enabled {
        say(enabled)
        say("branch")
    } else {
        say(false)
    }

    repeat 2 times {
        say("tick")
    }

    let x = 12
    let result = square(x)
    say(result)

    say(sqrt(144.0))
    say(sin(0.0))
    say(cos(0.0))
    say(pow(2.0, 3.0))
    say(abs(-5.0))

    let numbers = [3, 4, 5]
    numbers[1] = 10
    say(numbers[1])
    let sum_numbers = 0
    for number in numbers {
        sum_numbers += number
    }
    say(sum_numbers)

    let half_open_sum = 0
    for index in 2..5 {
        half_open_sum += index
    }
    say(half_open_sum)

    let inclusive_sum = 0
    for index in 1..=5 {
        if index == 2 { continue }
        if index == 5 { break }
        inclusive_sum += index
    }
    say(inclusive_sum)

    let empty_sum = 0
    for index in 5..=3 {
        empty_sum += index
    }
    say(empty_sum)

    for maximum in 9223372036854775807..=9223372036854775807 {
        say(maximum)
    }
}

make combine(left: int, right: int) -> int {
    return left + right
}

make square(x: int) -> int {
    return x * x
}

make factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

make is_even(n: int) -> bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

make is_odd(n: int) -> bool {
    if n == 0 { return false }
    return is_even(n - 1)
}

make sum_array(values: int[3]) -> int {
    let total = 0
    for value in values {
        total += value
    }
    return total
}

make replace_first(values: int[3], replacement: int) -> int[3] {
    values[0] = replacement
    return values
}

make identity_array(values: int[3]) -> int[3] {
    return values
}

make average_values(values: float[2]) -> float {
    return (values[0] + values[1]) / 2.0
}

make first_label(values: string[2]) -> string {
    return values[0]
}

make both_flags(values: bool[2]) -> bool {
    return values[0] && values[1]
}

make identity_floats(values: float[2]) -> float[2] {
    return values
}

make identity_labels(values: string[2]) -> string[2] {
    return values
}

make identity_flags(values: bool[2]) -> bool[2] {
    return values
}

make trace_int(value: int) -> int {
    say(value)
    return value
}

make trace_bool(marker: int, result: bool) -> bool {
    say(marker)
    return result
}

make combine_values(left: int, right: int) -> int {
    return left * 10 + right
}
