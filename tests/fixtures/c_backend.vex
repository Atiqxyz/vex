make main() {
    say(factorial(5))
    say(is_even(8))
    say(is_odd(7))
    let total = combine(10, 20)
    say(total)

    let message = "VEX\ncompiler"
    say(message)

    let same = "VEX" == "VEX"
    let enabled = same && total == 30
    if enabled {
        say(enabled)
        say("branch")
    } else {
        say(false)
    }

    repeat 2 times {
        say("tick")
    }

    let x = 12
    let result = square(x)
    say(result)

    say(sqrt(144.0))
    say(sin(0.0))
    say(cos(0.0))
    say(pow(2.0, 3.0))
    say(abs(-5.0))

    let numbers = [3, 4, 5]
    numbers[1] = 10
    say(numbers[1])
    let sum_numbers = 0
    for number in numbers {
        sum_numbers += number
    }
    say(sum_numbers)

    let half_open_sum = 0
    for index in 2..5 {
        half_open_sum += index
    }
    say(half_open_sum)

    let inclusive_sum = 0
    for index in 1..=5 {
        if index == 2 { continue }
        if index == 5 { break }
        inclusive_sum += index
    }
    say(inclusive_sum)

    let empty_sum = 0
    for index in 5..=3 {
        empty_sum += index
    }
    say(empty_sum)

    for maximum in 9223372036854775807..=9223372036854775807 {
        say(maximum)
    }
}

make combine(left: int, right: int) -> int {
    return left + right
}

make square(x: int) -> int {
    return x * x
}

make factorial(n: int) -> int {
    if n <= 1 { return 1 }
    return n * factorial(n - 1)
}

make is_even(n: int) -> bool {
    if n == 0 { return true }
    return is_odd(n - 1)
}

make is_odd(n: int) -> bool {
    if n == 0 { return false }
    return is_even(n - 1)
}
