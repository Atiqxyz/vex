struct StringBuilder {
    chunks: string[],
}

make builder_append(builder: StringBuilder, chunk: string) {
    push(builder.chunks, chunk)
}

make builder_build(builder: StringBuilder) -> string {
    return join(builder.chunks)
}

struct Strings {
    title: string,
    labels: string[2],
}

make main() {
    let strings = Strings {
        title: "VEX",
        labels: ["A", "B"]
    }
    strings.title += " Lang"
    strings.labels[0] += "\0C"
    let joined = "A" + "B" + ""
    let bytes = "A\0B" + "C\0D"
    let bytes_expected = "A\0BC\0D"
    let empty_left = "" + "VEX"
    let empty_right = "VEX" + ""
    let both_empty = "" + ""
    let original = "immutable"
    let original_copy = original
    let extended = original + "!"
    say(strings.title)
    say(joined)
    say(bytes == bytes_expected)
    say(empty_left)
    say(empty_right)
    say(both_empty == "")
    say(strings.labels[0] == "A\0C")
    say(original_copy == "immutable")
    say(original == "immutable")
    say(extended == "immutable!")
    say(length(strings.title))
    say(length(strings.labels[0]))
    say(length(bytes))
    say(length(""))

    let builder = StringBuilder { chunks: [] }
    builder_append(builder, "VEX")
    builder_append(builder, " ")
    builder_append(builder, "builder")
    let snapshot = builder_build(builder)
    builder_append(builder, "!")
    say(snapshot == "VEX builder")
    say(builder_build(builder) == "VEX builder!")

    let empty_chunks: string[] = []
    say(join(empty_chunks) == "")
    let binary_chunks: string[] = []
    push(binary_chunks, "A\0")
    push(binary_chunks, "B\0C")
    let binary_joined = join(binary_chunks)
    say(binary_joined == "A\0B\0C")
    say(length(binary_joined))

    let large_builder = StringBuilder { chunks: [] }
    repeat 100000 times {
        builder_append(large_builder, "x")
    }
    let large_result = builder_build(large_builder)
    say(length(large_result))
}
