make total(rows: int[][]) -> int {
    let result = 0
    for row in rows {
        for value in row {
            result += value
        }
    }
    return result
}

make first_row(rows: int[][]) -> int[] {
    return rows[0]
}

make main() {
    let rows: int[][] = [[1, 2], [3, 4, 5]]
    say(length(rows))
    say(length(rows[0]))

    rows[0][1] = 10
    push(rows, [6, 7])
    push(rows[1], 9)

    say(length(rows))
    say(length(rows[1]))

    let removed = pop(rows)
    say(removed[1])
    say(length(rows))
    say(total(rows))

    let row = first_row(rows)
    say(length(row))
}
