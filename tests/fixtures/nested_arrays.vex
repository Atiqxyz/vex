struct Point {
    x: int,
}

struct Grid {
    rows: int[][],
}

struct GridHolder {
    grid: Grid,
}

struct FixedOuterRows {
    rows: int[2][],
}

struct DynamicOuterRows {
    rows: int[][2],
}

struct TreeNode {
    value: int,
    children: TreeNode[],
}

make total(rows: int[][]) -> int {
    let result = 0
    for row in rows {
        for value in row {
            result += value
        }
    }
    return result
}

make first_row(rows: int[][]) -> int[] {
    return rows[0]
}

make first_plane(cubes: int[][][]) -> int[][] {
    return cubes[0]
}

make mark_index(calls: int[], marker: int, index: int) -> int {
    push(calls, marker)
    return index
}

make rhs_value(calls: int[]) -> int {
    push(calls, 30)
    return 5
}

make select_array(calls: int[], values: int[]) -> int[] {
    push(calls, 1)
    return values
}

make copy_grid(grid: Grid) -> Grid {
    return grid
}

make extend_grid(grid: Grid) {
    reserve(grid.rows, 8)
    reserve(grid.rows[0], 8)
    push(grid.rows[0], 9)
    push(grid.rows, [5, 6])
}

make extend_fixed_rows(rows: FixedOuterRows) {
    reserve(rows.rows[0], 8)
    push(rows.rows[0], 30)
}

make extend_grid_array(grids: Grid[]) {
    push(grids[0].rows[0], 60)
}

make main() {
    let rows: int[][] = [[1, 2], [3, 4, 5]]
    say(length(rows))
    say(length(rows[0]))

    rows[0][1] = 10
    let calls: int[] = []
    rows[mark_index(calls, 10, 0)][mark_index(calls, 20, 1)] += rhs_value(calls)
    say(rows[0][1])
    say(length(calls))
    say(calls[0])
    say(calls[1])
    say(calls[2])

    let alias = rows
    push(rows[0], 11)
    say(length(alias[0]))
    reserve(rows[0], 8)
    say(capacity(alias[0]) >= 8)

    push(rows, [6, 7])
    push(rows[1], 9)
    say(length(rows))
    say(length(rows[1]))

    let removed = pop(rows)
    say(removed[1])
    say(length(rows))
    say(total(rows))

    let row = first_row(rows)
    say(length(row))
    let removed_inner = pop(rows[0])
    say(removed_inner)
    say(length(alias))

    let empty_rows: int[][] = [[], [1, 2]]
    say(length(empty_rows[0]))

    let fixed_empty: int[2][] = [[], [7, 8]]
    push(fixed_empty[0], 9)
    say(fixed_empty[0][0])

    let fixed_outer: int[2][] = [[10, 20], [30,]]
    let fixed_copy = fixed_outer
    push(fixed_outer[0], 30)
    fixed_outer[1][0] = 40
    say(length(fixed_copy[0]))
    say(fixed_copy[1][0])

    let fixed_rows: int[][2] = [[5, 6], [7, 8]]
    let fixed_rows_alias = fixed_rows
    fixed_rows[0][1] = 60
    say(fixed_rows_alias[0][1])
    let detached = fixed_rows[0]
    fixed_rows[0][1] = 61
    say(detached[1])
    let removed_fixed = pop(fixed_rows)
    say(removed_fixed[0])

    let cubes: int[][][] = [[[1, 2], [3,]], [[4,],]]
    say(length(cubes[0][1]))
    push(cubes[0][1], 5)
    say(cubes[0][1][1])
    let plane = first_plane(cubes)
    say(plane[0][1])

    let grid = Grid { rows: [[1, 2], [3,]] }
    push(grid.rows[0], 8)
    say(grid.rows[0][2])

    let points: Point[][] = [
        [Point { x: 1 }, Point { x: 2 }],
        [Point { x: 3 }, Point { x: 4 }]
    ]
    points[1][0].x += 3
    say(points[1][0].x)

    let iterator_calls: int[] = []
    let growing: int[] = [1, 2]
    let growing_alias = growing
    let visited = 0
    for value in select_array(iterator_calls, growing) {
        say(value)
        visited += value
        if value == 1 {
            push(growing_alias, 3)
        }
        if value == 2 {
            growing_alias[2] = 30
            reserve(growing_alias, 16)
            push(growing_alias, 4)
        }
    }
    say(length(iterator_calls))
    say(length(growing))
    say(visited)

    let selected: int[] = [5, 6, 7]
    let replacement: int[] = [90, 91, 92]
    for value in selected {
        say(value)
        if value == 5 {
            selected = replacement
        }
    }
    say(selected[0])

    let fixed_values = [8, 9, 10]
    for value in fixed_values {
        say(value)
        if value == 8 {
            fixed_values[1] = 99
        }
    }
    say(fixed_values[1])

    let shrinking: int[] = [11, 22, 33, 44]
    let shrinking_alias = shrinking
    for value in shrinking {
        say(value)
        pop(shrinking_alias)
    }
    say(length(shrinking))
    say(shrinking[0])
    say(shrinking[1])

    let source_grid = Grid { rows: [[1, 2], [3, 4]] }
    let returned_grid = copy_grid(source_grid)
    let holder = GridHolder { grid: returned_grid }
    let holder_copy = holder
    extend_grid(holder_copy.grid)
    say(length(source_grid.rows))
    say(length(source_grid.rows[0]))
    say(source_grid.rows[0][2])
    say(source_grid.rows[1][0])
    say(source_grid.rows[2][1])
    say(capacity(source_grid.rows) >= 8)
    say(capacity(source_grid.rows[0]) >= 8)
    holder_copy.grid.rows[1] = [70, 71]
    say(source_grid.rows[1][0])
    let removed_grid_row = pop(holder_copy.grid.rows)
    say(removed_grid_row[1])
    say(length(source_grid.rows))
    let removed_grid_value = pop(holder_copy.grid.rows[0])
    say(removed_grid_value)
    say(length(source_grid.rows[0]))

    let fixed_source = FixedOuterRows { rows: [[10, 20], [30, 40]] }
    let fixed_struct_copy = fixed_source
    extend_fixed_rows(fixed_struct_copy)
    fixed_struct_copy.rows[1] = [99, 100]
    say(length(fixed_source.rows[0]))
    say(fixed_source.rows[0][2])
    say(fixed_source.rows[1][0])
    say(fixed_struct_copy.rows[1][0])

    let dynamic_source = DynamicOuterRows { rows: [[1, 2], [3, 4]] }
    let dynamic_copy = dynamic_source
    let detached_row = dynamic_source.rows[0]
    reserve(dynamic_copy.rows, 8)
    dynamic_copy.rows[0][0] = 50
    dynamic_copy.rows[1] = [90, 91]
    dynamic_copy.rows[0][1] = 55
    say(capacity(dynamic_source.rows) >= 8)
    say(dynamic_source.rows[0][0])
    say(dynamic_source.rows[1][0])
    say(detached_row[0])
    say(detached_row[1])
    say(dynamic_copy.rows[0][1])

    let grid_array: Grid[] = [Grid { rows: [[4, 5],] },]
    let grid_array_alias = grid_array
    extend_grid_array(grid_array_alias)
    say(grid_array[0].rows[0][2])

    let root_node = TreeNode { value: 1, children: [] }
    let root_node_copy = root_node
    push(root_node_copy.children, TreeNode { value: 2, children: [] })
    say(length(root_node.children))
    say(root_node.children[0].value)
}
