struct Point { x: int, y: int }
struct Packet { event: Event, history: Event[2] }
enum Event { Started, Moved(Point), Pair(int[2]), Samples(int[]), Failed(string) }

make create_samples() -> Event {
    let samples: int[] = []
    push(samples, 7)
    push(samples, 9)
    return Event.Samples(samples)
}

make inspect(event: Event) -> int {
    let result = 0
    match event {
        Event.Started => { result = 1 }
        Event.Moved(point) => { result = point.x + point.y }
        Event.Pair(values) => { result = values[0] * 10 + values[1] }
        Event.Samples(values) => { result = length(values) * 100 + values[0] + values[1] }
        Event.Failed(message) => { result = length(message) + 500 }
    }
    return result
}

make create_events() -> Event[] {
    let values: Event[] = []
    push(values, Event.Started)
    push(values, Event.Moved(Point { x: 1, y: 2 }))
    return values
}

make append_event(values: Event[], event: Event) {
    push(values, event)
}

make main() {
    let packet = Packet {
        event: Event.Moved(Point { x: 20, y: 22 }),
        history: [Event.Started, Event.Failed("oops")]
    }
    say(inspect(packet.event))
    say(inspect(packet.history[0]))
    say(inspect(packet.history[1]))
    say(inspect(Event.Pair([3, 4])))
    say(inspect(create_samples()))

    let events = create_events()
    let alias = events
    append_event(events, create_samples())
    let total = 0
    let appended = false
    for event in events {
        total += inspect(event)
        if !appended {
            appended = true
            reserve(alias, 8)
            push(alias, Event.Started)
        }
    }
    say(total)
    say(length(events))
    say(capacity(alias) >= 8)

    events[1] = Event.Pair([3, 4])
    say(inspect(events[1]))
    let removed = pop(alias)
    say(inspect(removed))
    say(length(events))
}
