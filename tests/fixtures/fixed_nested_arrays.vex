struct MatrixBox {
    cells: int[2][3],
}

make transform(matrix: int[2][3]) -> int[2][3] {
    let copy = matrix
    copy[1][1] += 100
    return copy
}

make main() {
    let matrix: int[2][3] = [[1, 2, 3], [4, 5, 6]]
    let detached = transform(matrix)
    say(matrix[1][1])
    say(detached[1][1])

    let copy = matrix
    copy[0][1] = 42
    say(matrix[0][1])
    say(copy[0][1])

    let box = MatrixBox { cells: matrix }
    box.cells[0][0] = 77
    say(box.cells[0][0])
    say(matrix[0][0])

    let inferred = [[7, 8], [9, 10]]
    say(inferred[1][0])
}
