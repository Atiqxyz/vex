struct Point {
    x: int,
}

struct Scene {
    origin: Point,
    points: Point[2],
}

make choose_index(calls: int[]) -> int {
    push(calls, 10)
    return 1
}

make rhs_value(calls: int[]) -> int {
    push(calls, 20)
    return 5
}

make main() {
    let scene = Scene {
        origin: Point { x: 10 },
        points: [Point { x: 2 }, Point { x: 3 }]
    }
    scene.origin.x += 5
    scene.points[0].x *= 4
    let calls: int[] = []
    scene.points[choose_index(calls)].x += rhs_value(calls)
    let values = [10, 20]
    values[1] -= 4
    values[1] %= 6
    let ratio = 1.5
    ratio += 2
    ratio *= 2
    say(scene.origin.x)
    say(scene.points[0].x)
    say(scene.points[1].x)
    say(length(calls))
    say(calls[0])
    say(calls[1])
    say(values[1])
    say(ratio)
}
