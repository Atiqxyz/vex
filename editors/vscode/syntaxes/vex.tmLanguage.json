{
  "scopeName": "source.vex",
  "name": "VEX",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vex",
          "match": "//.*$"
        },
        {
          "name": "comment.block.vex",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.vex",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vex",
          "match": "\\\\(?:[nrt0\\\\\"']|.)"
        }
      ]
    },
    "function-declaration": {
      "match": "\\b(make)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.function.vex" },
        "2": { "name": "entity.name.function.vex" }
      }
    },
    "keywords": {
      "name": "keyword.control.vex",
      "match": "\\b(?:let|const|if|else|while|break|continue|repeat|times|for|in|return)\\b"
    },
    "types": {
      "name": "storage.type.primitive.vex",
      "match": "\\b(?:int|float|bool|string|void)\\b"
    },
    "constants": {
      "name": "constant.language.boolean.vex",
      "match": "\\b(?:true|false)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.vex",
          "match": "(?<![A-Za-z0-9_])(?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|(?<![A-Za-z0-9_])[0-9]+[eE][+-]?[0-9]+"
        },
        {
          "name": "constant.numeric.integer.vex",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "builtins": {
      "name": "support.function.builtin.vex",
      "match": "\\bsay(?=\\s*\\()"
    },
    "operators": {
      "name": "keyword.operator.vex",
      "match": "->|\\.\\.=|\\.\\.|==|!=|<=|>=|&&|\\|\\||[+*/%<>=!-]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.vex",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.vex",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.group.begin.vex",
          "match": "[\\[(]"
        },
        {
          "name": "punctuation.section.group.end.vex",
          "match": "[\\])]"
        },
        {
          "name": "punctuation.separator.vex",
          "match": "[,:]"
        }
      ]
    }
  }
}
