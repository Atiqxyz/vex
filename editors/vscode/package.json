{
  "name": "vex-language",
  "displayName": "VEX Language Support",
  "description": "Language support and compiler actions for the VEX programming language.",
  "version": "0.1.0",
  "publisher": "Atiqxyz",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "vex",
    "language",
    "systems programming"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vex",
    "onCommand:vex.checkCurrentFile",
    "onCommand:vex.emitCPreview",
    "onCommand:vex.buildCurrentFile",
    "onCommand:vex.runCurrentFile"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vex",
        "aliases": [
          "VEX",
          "vex"
        ],
        "extensions": [
          ".vex"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vex",
        "scopeName": "source.vex",
        "path": "./syntaxes/vex.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vex",
        "path": "./snippets/vex.json"
      }
    ],
    "commands": [
      {
        "command": "vex.checkCurrentFile",
        "title": "VEX: Check Current File",
        "icon": "$(check)"
      },
      {
        "command": "vex.emitCPreview",
        "title": "VEX: Generate C Preview",
        "icon": "$(file-code)"
      },
      {
        "command": "vex.buildCurrentFile",
        "title": "VEX: Build Current File",
        "icon": "$(tools)"
      },
      {
        "command": "vex.runCurrentFile",
        "title": "VEX: Run Current File",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vex.checkCurrentFile",
          "when": "editorLangId == vex",
          "group": "navigation"
        },
        {
          "command": "vex.emitCPreview",
          "when": "editorLangId == vex",
          "group": "navigation"
        },
        {
          "command": "vex.buildCurrentFile",
          "when": "editorLangId == vex",
          "group": "navigation"
        },
        {
          "command": "vex.runCurrentFile",
          "when": "editorLangId == vex",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VEX",
      "properties": {
        "vex.compilerPath": {
          "type": "string",
          "default": "vex",
          "description": "Path to the VEX compiler executable. Use an absolute path if VEX is not available on PATH."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Atiqxyz/vex.git",
    "directory": "editors/vscode"
  },
  "files": [
    "extension.js",
    "language-configuration.json",
    "snippets/**",
    "syntaxes/**",
    "README.md"
  ]
}
